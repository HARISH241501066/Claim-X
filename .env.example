# Copy to .env (git-ignored) and fill in only what you use. Every value here is intentionally empty.

# Who writes the brief: none (built-in template, the default), anthropic, xai or groq.
LLM_PROVIDER=
# The provider's API key; it only ever goes to that provider's client and is never logged.
LLM_API_KEY=
# Optional model override; defaults are claude-opus-5-5, grok-4 and openai/gpt-oss-120b.
LLM_MODEL=

# Set to true to also email high-priority cases to the SIU team through AWS SNS (off by default).
NOTIFY_EMAIL_ENABLED=
# The SNS topic that receives those emails (an ARN).
SNS_TOPIC_ARN=
# The AWS region of that topic, for example eu-north-1.
AWS_REGION=
# AWS access key id; leave empty to use an AWS profile or role instead (needs only sns:Publish on the topic).
AWS_ACCESS_KEY_ID=
# AWS secret access key that goes with the key id above.
AWS_SECRET_ACCESS_KEY=
# Optional temporary-credentials token, only when your AWS credentials are temporary.
AWS_SESSION_TOKEN=
# The address of the web app, used for the link in notification emails (default http://localhost:5173).
APP_BASE_URL=

# Signs the 8-hour login tokens; 32+ random characters, for example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# The password given to every seeded demo user (admin, south_lead, south_inv1, ...); 8+ characters.
DEMO_PASSWORD=

# Optional: use another audit database file (decisions, assignments, notifications, brief cache).
CLAIMSHIELD_AUDIT_PATH=
# Optional, for the web app: the API address when it is not http://localhost:8000.
VITE_API_URL=
