# Which LLM may write briefs: anthropic, xai, groq or none (default: none).
LLM_PROVIDER=
# The key for that provider. Keep it here in .env; never commit it.
LLM_API_KEY=
# Optional: a model name to use instead of the provider default.
LLM_MODEL=

# Notifications: every flag appears in the platform. Only urgent cases also send an email to the
# SIU team through AWS SNS (credentials come from the usual AWS sources, never from this file).
NOTIFY_EMAIL_ENABLED=
SNS_TOPIC_ARN=
AWS_REGION=
APP_BASE_URL=
